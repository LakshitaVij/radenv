# Secrets - never commit real API keys
.openrouter_key
.openai_key
*.key

# Dependencies / build artifacts
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.vite/
dist/
build/

# Real patient data - included deliberately (private repo, explicit
# decision) so the pipeline runs end to end out of the box. Only the exact
# files the code actually reads are included - everything CSV-shaped is
# excluded first, then the 2 real source files (confirmed via oracle.py's
# own GOLD_CSV/FOLLOWUP_CSV constants) are explicitly re-included below.
# Negation lines must come AFTER the pattern they're un-ignoring, or git
# silently re-excludes them - keep this order. Everything in
# dicom_by_visit/ IS included (no exclude on that directory at all) since
# every file there is real per-visit imaging data the pipeline needs.
*.csv
!csv/consolidated_real_reports.csv
!generated_followups_fin.csv
*.numbers

# Generated run artifacts - eval episodes, receipts, results, logs
computer_use_eval/episodes/
computer_use_eval/*_batch*/
computer_use_eval/regraded*/
computer_use_eval/task_batch*/
computer_use_eval/run_full_batch*/
*.jsonl
*.log

# The real upstream OpenEMR clone - not ours to commit, tracked separately
# via the patch file instead (see README)
openemr/

# OHIF - parked/not currently in use
ohif-viewer/

# Editor/OS cruft
.DS_Store
*.code-workspace
.vscode/
