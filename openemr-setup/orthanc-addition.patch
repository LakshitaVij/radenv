diff --git a/docker/development-easy/docker-compose.yml b/docker/development-easy/docker-compose.yml
index 5b4e239..a3801e1 100644
--- a/docker/development-easy/docker-compose.yml
+++ b/docker/development-easy/docker-compose.yml
@@ -195,7 +195,35 @@ services:
       interval: 30s
       timeout: 5s
       retries: 3
+  # Real DICOM/DICOMweb server for OHIF - ships with the DICOMweb plugin
+  # enabled by default, matching ohif-viewer's active config
+  # (defaultDataSourceName: 'orthancProxy', qidoRoot/wadoRoot: /pacs/dicom-web).
+  # Local dev only - auth disabled, matches how OpenEMR itself is configured
+  # for this environment.
+  orthanc:
+    restart: always
+    image: orthancteam/orthanc:26.7.0@sha256:99082b87c96d56e57472d703ad799b779da7aa35aedac830d58cce646a43643f
+    ports:
+    - "${WT_ORTHANC_HTTP_PORT:-8042}:8042"
+    - "${WT_ORTHANC_DICOM_PORT:-4242}:4242"
+    environment:
+      ORTHANC__NAME: "ChartR Orthanc"
+      ORTHANC__DICOM_AET: "CHARTR"
+      ORTHANC__AUTHENTICATION_ENABLED: "false"
+      ORTHANC__REMOTE_ACCESS_ALLOWED: "true"
+      ORTHANC__DICOM_WEB__ENABLE: "true"
+      ORTHANC__DICOM_WEB__ROOT: "/dicom-web/"
+      VIRTUAL_HOST: "localhost"
+    volumes:
+    - orthancvolume:/var/lib/orthanc/db
+    healthcheck:
+      test: ["CMD", "curl", "-f", "http://localhost:8042/system"]
+      start_period: 20s
+      interval: 30s
+      timeout: 5s
+      retries: 3
 volumes:
+  orthancvolume: {}
   databasevolume: {}
   assetvolume: {}
   themevolume: {}
