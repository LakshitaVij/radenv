diff --git a/interface/forms/xray_viewer/view.php b/interface/forms/xray_viewer/view.php
new file mode 100644
index 0000000..bcf34d0
--- /dev/null
+++ b/interface/forms/xray_viewer/view.php
@@ -0,0 +1,13 @@
+<?php
+
+/**
+ * X-ray Viewer form view.php
+ *
+ * Same as clinical_notes/view.php: viewing an existing X-ray Viewer form is
+ * identical to opening it fresh (it's a live image viewer, not stored
+ * editable text), so there's no separate read-only state to render.
+ *
+ * @package OpenEMR
+ */
+
+require("new.php");
